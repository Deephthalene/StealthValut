{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StealthVault",
  "version": "0.1.0",
  "identifier": "com.stealthvault.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "windows": [
      {
        "title": "StealthVault",
        "width": 1600,
        "height": 900,
        "minWidth": 800,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  }
}
